{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RailSpotting",
  "identifier": "com.railspotting.receiver",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Hears railroad radio and reports to RailSpotting",
    "copyright": "RailSpotting",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
