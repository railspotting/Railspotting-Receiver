<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements under the hardened runtime (release builds; packaging/macos/README.md). -->
<plist version="1.0">
<dict>
	<!-- librtlsdr comes from Homebrew, signed by nobody the app knows: without this, macOS
	     refuses to load it and no dongle works. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- the Live Map's Here button (src/here.rs) -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
